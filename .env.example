# Copy to .env and fill in. Shield uses Gemini when GEMINI_API_KEY is set.
# PayPal is mocked unless PAYPAL_MODE=sandbox (needs the sandbox client id + secret).
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_SECRET=your-sandbox-secret
PAYPAL_BASE=https://api-m.sandbox.paypal.com
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Public URL of the app: startup links, PayPal return links, the link in guardian alerts.
# Not needed on Render (it uses RENDER_EXTERNAL_URL). For phones on your Wi-Fi: http://<laptop-ip>:8000
GUARDRAIL_BASE_URL=http://127.0.0.1:8000

# Zapier "Catch Hook" URL (Webhooks by Zapier trigger). Held payments are sent here so the
# Zap can email/text the guardian. Leave empty to only log alerts.
ZAPIER_HOOK_URL=
