# Copy to .env and fill in. Shield uses Gemini when GEMINI_API_KEY is set.
# PayPal is mocked unless PAYPAL_MODE=sandbox (needs the sandbox client id + secret).
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_SECRET=your-sandbox-secret
PAYPAL_BASE=https://api-m.sandbox.paypal.com
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Used only for the URLs printed on startup.
GUARDRAIL_BASE_URL=http://127.0.0.1:8000
